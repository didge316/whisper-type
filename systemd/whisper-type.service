[Unit]
Description=whisper-type F9 push-to-type
Documentation=file://%h/AI/whisper/v1/README.md
After=graphical-session.target

[Service]
Type=simple
# run.sh sets the venv PATH, loads conf.env, and execs the daemon. %h is the
# user's home, so this works for any user. Override the interpreter per-machine
# with WHISPER_PYTHON if your venv lives elsewhere:
#   Environment=WHISPER_PYTHON=/path/to/python
ExecStart=%h/AI/whisper/v1/scripts/run.sh
# Always: the daemon exits 0 on SIGTERM/SIGINT, so on-failure would leave it
# dead after any external kill (e.g. a debugging session). systemctl stop is
# still respected under Restart=always.
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
