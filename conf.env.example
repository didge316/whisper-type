# conf.env — copy to this filename to set overrides for scripts/run.sh (sourced).
# These are per-machine settings. The defaults inside whisper_type.py are already
# home/repo-relative, so you usually only need to uncomment + edit the whisper.cpp
# paths below to match WHERE YOU built whisper.cpp and put your model.

# SDL capture device. Leave commented to AUTO-DETECT the best-named mic.
# Set explicitly if auto-detect picks the wrong source.
# export WHISPER_DEVICE_ID=0

# Recorder binary (ships with the repo at bin/sdl_rec by default).
# export WHISPER_RECORD_BIN="$HOME/.local/bin/sdl_rec"

# whisper.cpp model — point at THE MODEL YOU HAVE (small/en/medium/large).
# export WHISPER_MODEL="$HOME/whisper.cpp/models/ggml-small.en.bin"

# whisper-cli binary — point at where YOU built it.
# export WHISPER_BIN="$HOME/whisper.cpp/build/bin/whisper-cli"

# Raw WAV path (whisper-cli writes <RAW>.json next to it).
# export WHISPER_RAW="/tmp/whisper-rec.wav"

# Non-empty -> print transcribed text instead of typing it (headless testing).
# export WHISPER_DRY=""

# Vocabulary file (-tv): one technical term per line. whisper treats these as
# legal words instead of spelling them phonetically. Edit vocab.txt in the repo.
# export WHISPER_VOCAB="$REPO/vocab.txt"

# Context prompt (-pt): primes the model to spell your terms correctly.
# export WHISPER_PROMPT="context: technical terms are Kestrel Telemetry Qdrant"
